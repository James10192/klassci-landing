{
  "name": "klassci-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "tsc": "tsc --noEmit",
    "verifier:amortisseur": "node --experimental-strip-types --conditions=react-server scripts/verifier-amortisseur.mjs",
    "verifier:identite-ecoles": "node --experimental-strip-types --conditions=react-server scripts/verifier-identite-ecoles.mjs",
    "verifier:seo": "node scripts/verifier-seo.mjs",
    "verifier:seo:prod": "node scripts/verifier-seo.mjs --url https://www.klassci.com",
    "verifier:schema": "node scripts/verifier-donnees-structurees.mjs",
    "verifier:budget": "node scripts/verifier-budget.mjs",
    "verifier:citations": "node scripts/verifier-citations.mjs",
    "verifier": "pnpm tsc && pnpm verifier:amortisseur && pnpm verifier:identite-ecoles && pnpm verifier:seo && pnpm build && pnpm verifier:schema && pnpm verifier:budget"
  },
  "dependencies": {
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.4.0",
    "@vercel/speed-insights": "^1.1.0",
    "framer-motion": "^11.18.2",
    "fumadocs-core": "^14.7.7",
    "fumadocs-mdx": "^11.10.1",
    "fumadocs-ui": "^14.7.7",
    "lucide-react": "^0.469.0",
    "next": "14.2.16",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.215.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "14.2.16",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  },
  "browserslist": {
    "production": [
      "Chrome >= 100",
      "Safari >= 15",
      "iOS >= 15",
      "Firefox >= 100",
      "Edge >= 100"
    ],
    "development": [
      "last 2 chrome version",
      "last 2 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
