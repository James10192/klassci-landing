# PostHog (project 1508541 — same as ADC)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Disable analytics in dev (set to "true" to skip)
NEXT_PUBLIC_DISABLE_ANALYTICS=true

# Tenant lookup proxy — points to Laravel KLASSCIv2 API
TENANT_LOOKUP_API_URL=https://docs.klassci.com/api/tenant-lookup
TENANT_LOOKUP_API_TOKEN=

# Web3Forms uses a public browser key for spam prevention.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Laravel host for docs / api-reference / changelog rewrites (next.config.mjs)
# Before DNS cutover, docs.klassci.com must be created on cpanel as an A record
# pointing to the same Laravel instance that currently serves klassci.com
# (91.234.194.113).
LARAVEL_DOCS_HOST=https://docs.klassci.com

# Site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://klassci.com

# Etablissements exclus du mur de logos de la page d'accueil, separes par des
# virgules. L'instance de demonstration n'a rien a faire parmi « nos
# etablissements » ; elle garde en revanche son identite sur sa propre page
# d'inscription, ou quelqu'un est venu la chercher.
#
# Ne PAS poser cette variable exclut « presentation » par defaut. La poser
# remplace ce defaut ; la poser VIDE n'exclut plus personne.
VITRINE_EXCLUS=presentation

# ─── Portail d'inscription : quelles ecoles klassci.com sert ────────────────
#
# La liste des codes servis, separes par des virgules. C'est ELLE qui decide :
# une ecole absente d'ici n'existe pas pour le portail, et sans cette variable
# aucune ecole n'est servie — un oubli de configuration FERME le portail, il ne
# l'ouvre pas.
REINSCRIPTION_TENANTS=presentation,esbtp-abidjan,esbtp-yakro,ephrata,hetec,rostan,usat
#
# Puis, pour CHAQUE code de la liste, deux variables obligatoires et une
# facultative. Le suffixe est le code en majuscules, tirets remplaces par des
# soulignes : « esbtp-yakro » donne « ESBTP_YAKRO ».
#
#   REINSCRIPTION_SECRET_<CODE>   requis, 32 caracteres minimum
#   REINSCRIPTION_BASE_<CODE>     requis, doit commencer par https://
#   REINSCRIPTION_LABEL_<CODE>    facultatif, le nom affiche
#
# Une ecole declaree dont le secret ou l'URL manque est SILENCIEUSEMENT absente
# du selecteur : elle ne s'affiche pas, et rien ne s'affiche a sa place. Le seul
# signe est une ligne d'avertissement au demarrage, qui nomme les manquantes et
# le motif. C'est ainsi que l'absence de « hetec » est passee inapercue.
#
# L'URL est exigee plutot que deduite du code : « rostan » est servi par
# islg.klassci.com, et rien ne dit qu'un futur produit logera ses instances sur
# des sous-domaines.
REINSCRIPTION_SECRET_ESBTP_YAKRO=
REINSCRIPTION_BASE_ESBTP_YAKRO=https://esbtp-yakro.klassci.com
REINSCRIPTION_LABEL_ESBTP_YAKRO=ESBTP Yakro

# Ecoles SERVIES mais non PROPOSEES dans le selecteur, separees par des virgules.
#
# A ne pas confondre avec INSTANCES_DEMONSTRATION ci-dessous, meme si l'effet
# visible est le meme. Une instance de demonstration n'est pas une ecole : elle
# n'a rien a faire non plus sur le mur de logos de l'accueil. Ici il s'agit
# d'ecoles bien reelles, qui restent parmi « nos etablissements », mais que
# klassci.com choisit de ne pas offrir aux familles dans son selecteur.
#
# Elles restent adressables par leur lien direct : ne plus proposer quelque
# chose n'est pas le retirer a qui vient le chercher.
#
# Vide par defaut — on ne cache personne sans l'avoir demande.
PORTAIL_NON_PROPOSES=ephrata

# Instances de demonstration : ecartees du selecteur d'inscription ET du mur de
# logos. Remplace VITRINE_EXCLUS, qui reste lu pour ne pas casser un
# deploiement existant. Sans cette variable, « presentation » est ecarte par
# defaut ; la poser VIDE n'ecarte plus personne.
INSTANCES_DEMONSTRATION=presentation
